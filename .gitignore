# Local editor and scratch files
*.swp
*~
teeeeeee.*
okfile.txt

# Rendered unit previews and local lynis reports
/systemd/*.rendered
/tsa/reports/*.dat

# Falco official rules: a locked snapshot is committed for deployment.
# Updates require source review, an explicit lock refresh, and validation.
# Only ignore transient editor/backup files here, not the committed snapshot.
/falco/official-rules/*.tmp
/falco/official-rules/*~

# Runtime data
state/
reports/
__pycache__/
*.pyc
